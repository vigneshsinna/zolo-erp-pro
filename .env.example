APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=http://localhost
# false only for the public demo (blocks settings changes and deletions)
USER_VERIFIED=true
# true seeds the SalePro demo catalog on db:seed (demo installs only)
SEED_DEMO_DATA=false
# Origin allowed to call /api from a browser (* = any); web screens never send CORS headers
API_CORS_ORIGIN=*

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Set true when PHP on Windows talks to MySQL inside WSL through 127.0.0.1 (avoids ~40 ms per query).
DB_EMULATE_PREPARES=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Keep gated packages disabled until their company, reconciliation and UAT acceptance.
ERP_SHARED_COMMERCIAL_ENABLED=false
ERP_COMPLIANCE_ENABLED=false
# Optional industry capabilities (job work, projects, ...) can be switched on after company isolation acceptance.
ERP_OPTIONAL_ACTIVATION_READY=false
# GSTIN autofill provider (e.g. https://www.gstinapi.in/v1/gstin with header x-api-key). Empty = offline state decode only.
GST_LOOKUP_URL=
GST_LOOKUP_TOKEN=
GST_LOOKUP_HEADER=
# Masters India GST API (GSTIN <-> legal name). Credentials come from Masters India sales; takes priority over GST_LOOKUP_URL.
MASTERSINDIA_USERNAME=
MASTERSINDIA_PASSWORD=
MASTERSINDIA_CLIENT_ID=
MASTERSINDIA_CLIENT_SECRET=
ERP_OPERATIONS_ENABLED=false

# Operator-only backups. Keep the encryption secret separate from backup storage.
ERP_BACKUP_ENABLED=false
ERP_BACKUP_PASSWORD=
ERP_BACKUP_OFFSITE_DISK=
ERP_MYSQLDUMP_BINARY=mysqldump
ERP_MYSQL_BINARY=mysql
# Fresh zolo_test_restore_* database; restricted user with privileges only on that database.
ERP_RESTORE_DB_HOST=127.0.0.1
ERP_RESTORE_DB_PORT=3306
ERP_RESTORE_DB_DATABASE=
ERP_RESTORE_DB_USERNAME=
ERP_RESTORE_DB_PASSWORD=
# Enable only after the delivery scheduler and real provider acceptance are confirmed.
ERP_DISPATCH_WORKER_CONFIRMED=false

# AI Operating Layer (Default: disabled, read-only)
AI_ENABLED=false
AI_READ_ONLY=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_DAILY_USER_REQUESTS=50
AI_DAILY_COMPANY_TOKENS=100000

